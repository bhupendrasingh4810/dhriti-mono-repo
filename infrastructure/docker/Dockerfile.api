# syntax=docker/dockerfile:1.7

ARG NODE_VERSION=22-alpine

FROM node:${NODE_VERSION} AS base
ARG PNPM_VERSION=11.22.0
ENV PNPM_HOME=/pnpm
ENV PATH="${PNPM_HOME}:${PATH}"
RUN corepack enable && corepack prepare "pnpm@${PNPM_VERSION}" --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY prisma ./prisma
COPY apps/api ./apps/api
COPY packages ./packages
RUN pnpm install --frozen-lockfile

FROM deps AS build
RUN pnpm --filter @dhriti/api db:generate \
  && pnpm --filter @dhriti/api build

FROM build AS deploy
RUN pnpm --filter @dhriti/api --prod --legacy deploy /app/.deploy/api

FROM node:${NODE_VERSION} AS production
ENV NODE_ENV=production
WORKDIR /app
COPY --from=deploy --chown=node:node /app/.deploy/api/package.json ./package.json
COPY --from=deploy --chown=node:node /app/.deploy/api/node_modules ./node_modules
COPY --from=deploy --chown=node:node /app/.deploy/api/dist ./dist
USER node
EXPOSE 3001
CMD ["node", "dist/main.js"]
