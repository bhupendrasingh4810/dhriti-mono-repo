{
  "name": "@dhriti/api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage",
    "test:e2e": "jest --config jest.config.cjs --testPathPattern=test",
    "db:build": "bash ../../scripts/build-prisma-schema.sh",
    "db:generate": "pnpm db:build && prisma generate --schema ../../prisma/schema.prisma",
    "db:migrate": "pnpm db:build && prisma migrate dev --schema ../../prisma/schema.prisma",
    "db:push": "pnpm db:build && prisma db push --schema ../../prisma/schema.prisma",
    "db:migrate:deploy": "pnpm db:build && prisma migrate deploy --schema ../../prisma/schema.prisma",
    "db:seed": "pnpm db:build && prisma db seed --schema ../../prisma/schema.prisma",
    "db:studio": "pnpm db:build && prisma studio --schema ../../prisma/schema.prisma",
    "db:reset": "pnpm db:build && prisma migrate reset --force --schema ../../prisma/schema.prisma",
    "validate": "pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.940.0",
    "@aws-sdk/s3-request-presigner": "^3.940.0",
    "@dhriti/auth": "workspace:*",
    "@dhriti/config": "workspace:*",
    "@dhriti/types": "workspace:*",
    "@dhriti/validation": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.0.0",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/websockets": "^11.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.65.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.206.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.206.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "@prisma/client": "^6.19.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "express-fileupload": "^1.5.2",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.0",
    "nestjs-cls": "^6.2.2",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.0.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.1",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "jest": "^30.3.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.69.0"
  }
}
