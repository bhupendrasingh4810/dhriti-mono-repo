# Core
NODE_ENV=development
PORT=3001
API_PREFIX=v1
WEB_APP_URL=http://localhost:3000
ONBOARDING_URL=http://localhost:3000/onboarding

# Comma-separated allowlist for CORS
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhriti?schema=public

# Redis 7+
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_MFA_SECRET=change-me-mfa-secret-min-32-chars
JWT_MFA_TTL_SECONDS=300

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# Account lockout
LOCKOUT_THRESHOLD=10
LOCKOUT_DURATION_MINUTES=15

# OAuth - Google
GOOGLE_CLIENT_ID=714899866031-trrgqm0om93i6odr74v4on858qii58uk.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=Ov23liDd3HUyZb3YzD7K
GITHUB_CLIENT_SECRET=8e92e94ecce6d9294983b6cbc29462d82fde29f5
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/github/callback

# File storage (S3-compatible: AWS S3, MinIO, etc.)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=dhriti-files
S3_ACCESS_KEY_ID=AKIARRM22KRBJMRLPSEP
S3_SECRET_ACCESS_KEY=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
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
FILE_MAX_SIZE_MB=25

# Nexus AI (leave unset to use the deterministic local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transactional email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
