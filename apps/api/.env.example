# Core
NODE_ENV=development
PORT=3001
API_PREFIX=v1
WEB_APP_URL=http://localhost:3000
ONBOARDING_URL=http://localhost:3000/onboarding

# Comma-separated allowlist for CORS
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhriti?schema=public

# Redis 7+
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_MFA_SECRET=change-me-mfa-secret-min-32-chars
JWT_MFA_TTL_SECONDS=300
# Required in production: base64-encoded 32-byte AES-256-GCM key.
SECRETS_ENCRYPTION_KEY=

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# Account lockout
LOCKOUT_THRESHOLD=10
LOCKOUT_DURATION_MINUTES=15
TRUST_PROXY=false
PUBLIC_AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_AUTH_RATE_LIMIT_MAX_REQUESTS=20
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=1200
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
MFA_PENDING_SECRET_TTL_SECONDS=600
MFA_RECOVERY_CODE_COUNT=10
PROFILE_PHOTO_MAX_SIZE_MB=2
REDIS_MAX_RETRIES_PER_REQUEST=3
REDIS_SCAN_COUNT=200
ENTITLEMENT_CACHE_TTL_SECONDS=60
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_DELIVERY_MAX_ATTEMPTS=3
WEBHOOK_DELIVERY_RETRY_BASE_DELAY_SECONDS=1

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/github/callback

# File storage (S3-compatible: AWS S3, MinIO, etc.)
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=dhriti-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
FILE_MAX_SIZE_MB=25

# Nexus AI (leave unset to use the deterministic local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Transactional email (Brevo)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Stripe billing webhooks
STRIPE_WEBHOOK_SECRET=
BILLING_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
BILLING_WEBHOOK_RATE_LIMIT_MAX_REQUESTS=120
BILLING_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300
BILLING_WEBHOOK_MAX_RETRY_ATTEMPTS=8
BILLING_WEBHOOK_PROCESSING_TIMEOUT_SECONDS=600
BILLING_WEBHOOK_RETRY_BASE_DELAY_SECONDS=60
BILLING_WEBHOOK_RETRY_MAX_DELAY_SECONDS=3600
BILLING_WEBHOOK_RETRY_INTERVAL_SECONDS=60
BILLING_WEBHOOK_RETRY_LEASE_TTL_SECONDS=55
BILLING_IDEMPOTENCY_LOCK_TTL_SECONDS=60
BILLING_IDEMPOTENCY_RESULT_TTL_SECONDS=86400
BILLING_WEBHOOK_RETRY_BATCH_SIZE=100
