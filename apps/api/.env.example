# Core
NODE_ENV=development
PORT=3001
API_PREFIX=v1
WEB_APP_URL=http://localhost:3000

# Comma-separated allowlist for CORS
CORS_ORIGINS=http://localhost:3000

# Database (PostgreSQL 15+)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dhriti?schema=public

# Redis 7+
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_MFA_SECRET=change-me-mfa-secret-min-32-chars
JWT_MFA_TTL_SECONDS=300

# Refresh tokens
REFRESH_TOKEN_TTL_DAYS=7

# Password hashing
BCRYPT_ROUNDS=12

# Account lockout
LOCKOUT_THRESHOLD=10
LOCKOUT_DURATION_MINUTES=15

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/google/callback

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/github/callback

# OAuth - Microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:3001/v1/auth/oauth/microsoft/callback
MICROSOFT_TENANT=common

# File storage (S3-compatible: AWS S3, MinIO, etc.)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=dhriti-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
FILE_MAX_SIZE_MB=25

# Nexus AI (leave unset to use the deterministic local fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
