model NoteViewOrder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  scope          String
  noteIds        String[] @db.Uuid
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, scope])
  @@index([userId])
  @@map("note_view_orders")
}

model NoteFolder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  ownerId        String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("NoteFolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  notes        Note[]

  @@index([organizationId, ownerId])
  @@map("note_folders")
}

model Note {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  ownerId        String   @db.Uuid
  folderId       String?  @db.Uuid
  title          String
  content        String   @default("") @db.Text
  isPublic       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User             @relation("NoteOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  folder       NoteFolder?      @relation(fields: [folderId], references: [id], onDelete: Cascade)
  permissions  NotePermission[]
  accessRequests NoteAccessRequest[]

  @@index([organizationId, ownerId, folderId])
  @@map("notes")
}

model NotePermission {
  id        String   @id @default(uuid()) @db.Uuid
  noteId    String   @db.Uuid
  userId    String   @db.Uuid
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  isOwner   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation("NotePermissionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId])
  @@map("note_permissions")
}

model NoteAccessRequest {
  id            String   @id @default(uuid()) @db.Uuid
  noteId        String   @db.Uuid
  userId        String   @db.Uuid
  requestedRole String
  grantedRole   String?
  status        String   @default("PENDING")
  reviewedById  String?  @db.Uuid
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation("NoteAccessRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@index([userId, status])
  @@map("note_access_requests")
}
