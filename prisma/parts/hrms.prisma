model HrmsEmployee {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  workLocationId String?  @db.Uuid
  shiftId        String?  @db.Uuid
  departmentId   String?  @db.Uuid
  designationId  String?  @db.Uuid
  reportingManagerId String? @db.Uuid
  employeeNumber String
  status         String
  employmentType String?
  startDate      DateTime?
  endDate        DateTime?
  biometricId    String?  @map("biometric_id") @db.VarChar(64)
  retirementDate DateTime? @map("retirement_date") @db.Date
  resignationDate DateTime? @map("resignation_date") @db.Date
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  workLocation HrmsLocation? @relation(fields: [workLocationId], references: [id], onDelete: SetNull)
  shift        HrmsShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  department   OrganizationDepartment? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  HrmsDesignation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  reportingManager HrmsEmployee? @relation("HrmsEmployeeReporting", fields: [reportingManagerId], references: [id], onDelete: SetNull)
  directReports HrmsEmployee[] @relation("HrmsEmployeeReporting")
  attendanceRecords HrmsAttendanceRecord[]
  attendanceRegularizations HrmsAttendanceRegularization[]
  leaveRequests HrmsLeaveRequest[]
  compOffRequests HrmsCompOffRequest[]
  performanceReviews HrmsPerformanceReview[] @relation("HrmsPerformanceReviewEmployee")
  conductedPerformanceReviews HrmsPerformanceReview[] @relation("HrmsPerformanceReviewReviewer")
  payrollRecords HrmsPayrollRecord[]
  salaryAssignments HrmsSalaryAssignment[]
  variablePayInputs HrmsVariablePayInput[]
  expenseClaims HrmsExpenseClaim[]
  trainingEnrollments HrmsTrainingEnrollment[]
  assignedAssets HrmsAsset[] @relation("HrmsAssetAssignee")
  benefitEnrollments HrmsBenefitEnrollment[]

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, status])
  @@index([organizationId, workLocationId])
  @@index([organizationId, departmentId])
  @@index([organizationId, shiftId])
  @@index([organizationId, reportingManagerId])
  @@map("hrms_employees")
}

model HrmsAttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  legacyAttendanceId String?      @db.Uuid
  employeeId     String           @db.Uuid
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  workHours      Float?
  // Completed break time; an in-progress break is tracked by breakStartedAt until it is ended or the user clocks out.
  breakMinutes   Int              @default(0)
  breakStartedAt DateTime?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@unique([organizationId, legacyAttendanceId])
  @@index([organizationId, date])
  @@index([employeeId, date])
  @@map("hrms_attendance_records")
}

/// Employee-raised correction for one attendance day. Approval applies the requested times to the day's attendance record.
model HrmsAttendanceRegularization {
  id               String                         @id @default(uuid()) @db.Uuid
  organizationId   String                         @db.Uuid
  employeeId       String                         @db.Uuid
  date             DateTime                       @db.Date
  type             AttendanceRegularizationType
  requestedCheckIn  DateTime?
  requestedCheckOut DateTime?
  reason           String                         @db.Text
  status           AttendanceRegularizationStatus @default(PENDING)
  decidedByUserId  String?                        @db.Uuid
  decidedAt        DateTime?
  decisionNote     String?                        @db.Text
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeId, date])
  @@map("hrms_attendance_regularizations")
}

model HrmsLeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  legacyLeaveRequestId String? @db.Uuid
  employeeId     String      @db.Uuid
  leaveType      LeaveType
  // Admin-managed type; `leaveType` mirrors its category so Pulse and legacy readers keep working.
  leaveTypeId    String?     @db.Uuid
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  totalDays      Float
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  // Set when the request was filed by someone else (apply-on-behalf).
  requestedByUserId String?  @db.Uuid
  moreInfoNote   String?     @db.Text
  moreInfoRequestedByUserId String? @db.Uuid
  moreInfoRequestedAt DateTime?
  moreInfoReply  String?     @db.Text
  // Supporting document stored via the shared file service (StoredFile); name is denormalised for display.
  attachmentFileId String?   @db.Uuid
  attachmentName String?
  approvedByUserId String?   @db.Uuid
  approvedAt     DateTime?
  rejectedByUserId String?   @db.Uuid
  rejectedAt     DateTime?
  rejectionReason String?    @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type         HrmsLeaveType? @relation(fields: [leaveTypeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@unique([organizationId, legacyLeaveRequestId])
  @@index([employeeId, startDate])
  @@map("hrms_leave_requests")
}

model HrmsWorkflowDefinition {
  id            String                       @id @default(uuid()) @db.Uuid
  organizationId String                      @db.Uuid
  name          String
  description   String?                      @db.Text
  status        HrmsWorkflowDefinitionStatus @default(DRAFT)
  version       Int                          @default(1)
  stages        Json                         @db.JsonB
  transitions   Json                         @db.JsonB
  templateKey   String?                      @db.VarChar(64)
  isTemplate    Boolean                      @default(false)
  isDefault     Boolean                      @default(false)
  createdByUserId String                    @db.Uuid
  updatedByUserId String?                   @db.Uuid
  publishedAt   DateTime?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  versions     HrmsWorkflowDefinitionVersion[]
  instances    HrmsWorkflowInstance[]

  @@index([organizationId, status])
  @@index([organizationId, isTemplate, status])
  @@unique([organizationId, templateKey])
  @@map("hrms_workflow_definitions")
}

// Published versions are append-only snapshots. Runtime instances additionally
// persist their own snapshot so later retention changes cannot alter history.
model HrmsWorkflowDefinitionVersion {
  id           String   @id @default(uuid()) @db.Uuid
  definitionId String   @db.Uuid
  version      Int
  name         String
  description  String?  @db.Text
  stages       Json     @db.JsonB
  transitions  Json     @db.JsonB
  publishedByUserId String @db.Uuid
  publishedAt  DateTime @default(now())

  definition HrmsWorkflowDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  instances  HrmsWorkflowInstance[]

  @@unique([definitionId, version])
  @@map("hrms_workflow_definition_versions")
}

model HrmsWorkflowInstance {
  id                  String                     @id @default(uuid()) @db.Uuid
  organizationId      String                     @db.Uuid
  definitionId        String                     @db.Uuid
  definitionVersionId String                     @db.Uuid
  definitionVersion   Int
  status              HrmsWorkflowInstanceStatus @default(ACTIVE)
  currentStageId      String
  context             Json                       @default("{}") @db.JsonB
  definitionSnapshot  Json                       @db.JsonB
  initiatedByUserId   String                     @db.Uuid
  completedAt         DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  definition         HrmsWorkflowDefinition         @relation(fields: [definitionId], references: [id], onDelete: Restrict)
  definitionVersionRecord HrmsWorkflowDefinitionVersion @relation(fields: [definitionVersionId], references: [id], onDelete: Restrict)
  assignments        HrmsWorkflowAssignment[]
  events             HrmsWorkflowEvent[]

  @@index([organizationId, status])
  @@index([organizationId, definitionId])
  @@index([organizationId, currentStageId])
  @@map("hrms_workflow_instances")
}

model HrmsWorkflowAssignment {
  id           String                       @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  instanceId   String                       @db.Uuid
  stageId      String
  assigneeUserId String                    @db.Uuid
  status       HrmsWorkflowAssignmentStatus @default(PENDING)
  actedAt      DateTime?
  comment      String?                      @db.Text
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt

  instance HrmsWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, stageId, assigneeUserId])
  @@index([organizationId, assigneeUserId, status])
  @@index([instanceId, stageId, status])
  @@map("hrms_workflow_assignments")
}

model HrmsWorkflowEvent {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  instanceId     String                @db.Uuid
  type           HrmsWorkflowEventType
  actorUserId    String?               @db.Uuid
  stageId        String?
  previousState  Json?                 @db.JsonB
  nextState      Json?                 @db.JsonB
  comment        String?               @db.Text
  evidence       Json?                 @db.JsonB
  createdAt      DateTime              @default(now())

  instance HrmsWorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([organizationId, instanceId, createdAt])
  @@map("hrms_workflow_events")
}

model HrmsPerformanceReview {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  legacyPerformanceReviewId String? @db.Uuid
  employeeId     String       @db.Uuid
  reviewerEmployeeId String   @db.Uuid
  reviewType     ReviewType
  cycle          String
  startDate      DateTime     @db.Date
  dueDate        DateTime     @db.Date
  completedAt    DateTime?
  status         ReviewStatus @default(PENDING)
  overallRating  Int?
  comments       String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation("HrmsPerformanceReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     HrmsEmployee  @relation("HrmsPerformanceReviewReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@unique([organizationId, legacyPerformanceReviewId])
  @@index([employeeId, dueDate])
  @@index([reviewerEmployeeId, dueDate])
  @@map("hrms_performance_reviews")
}

model HrmsPayrollRecord {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  legacyPayrollRecordId String? @db.Uuid
  employeeId     String        @db.Uuid
  runId          String?       @db.Uuid
  period         String
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  payDate        DateTime      @db.Date
  grossSalary    Float
  totalDeductions Float
  netPay         Float
  currency       String        @default("USD")
  status         PayrollStatus @default(DRAFT)
  approvedByUserId String?     @db.Uuid
  approvedAt     DateTime?
  paidAt         DateTime?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  run          HrmsPayrollRun? @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([employeeId, period])
  @@unique([organizationId, legacyPayrollRecordId])
  @@index([organizationId, status])
  @@index([runId])
  @@map("hrms_payroll_records")
}

/// Country profiles are administrator-verified configuration, not bundled statutory compliance.
model HrmsPayrollProfile {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  name           String
  countryCode    String @db.VarChar(2)
  currency       String @db.VarChar(3)
  minorUnits     Int @default(2)
  frequency      String @default("MONTHLY")
  /// Anchor is the first day of a weekly/biweekly cycle; dates use UTC calendar days.
  calendarAnchor DateTime? @db.Date
  payDateOffset  Int @default(0)
  employmentModel String @default("EMPLOYEE")
  workLocationId String? @db.Uuid
  registration   String?
  rulesVerified  Boolean @default(false)
  effectiveFrom  DateTime @db.Date
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  structures HrmsSalaryStructure[]
  runs HrmsPayrollRun[]
  variablePayInputs HrmsVariablePayInput[]
  @@unique([organizationId, name])
  @@map("hrms_payroll_profiles")
}

/// Ordered, validated components support fixed and percentage formulas without evaluating arbitrary code.
model HrmsSalaryStructure {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  profileId      String @db.Uuid
  name           String
  components     Json @db.JsonB
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile HrmsPayrollProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  assignments HrmsSalaryAssignment[]
  @@unique([organizationId, profileId, name])
  @@map("hrms_salary_structures")
}

/// Revisions append history; a run snapshots the applicable revision rather than mutating old payslips.
model HrmsSalaryAssignment {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  employeeId     String @db.Uuid
  structureId    String @db.Uuid
  monthlyGross   Decimal @db.Decimal(18, 4)
  effectiveFrom  DateTime @db.Date
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  structure HrmsSalaryStructure @relation(fields: [structureId], references: [id], onDelete: Restrict)
  @@unique([employeeId, effectiveFrom])
  @@index([organizationId, effectiveFrom])
  @@map("hrms_salary_assignments")
}

model HrmsExpenseClaim {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  employeeId     String @db.Uuid
  title          String
  amount         Decimal @db.Decimal(18, 4)
  currency       String @db.VarChar(3)
  expenseDate    DateTime @db.Date
  receiptReference String
  status         String @default("PENDING")
  approvedById   String? @db.Uuid
  runId          String? @db.Uuid
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  run HrmsPayrollRun? @relation(fields: [runId], references: [id], onDelete: Restrict)
  @@index([organizationId, status])
  @@map("hrms_expense_claims")
}

/// Approved inputs are immutable: monthly ranges recur by month; other calendars target one exact period.
model HrmsVariablePayInput {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  employeeId     String @db.Uuid
  profileId      String @db.Uuid
  name           String
  type           String
  calculation    String
  quantity       Decimal @db.Decimal(18, 4)
  rate           Decimal @db.Decimal(18, 4)
  multiplier     Decimal @db.Decimal(8, 4)
  amount         Decimal @db.Decimal(18, 4)
  startPeriod    String @db.VarChar(7)
  endPeriod      String @db.VarChar(7)
  /// Non-monthly inputs target exactly one canonical period; legacy monthly ranges remain unchanged.
  targetPeriod   String? @db.VarChar(10)
  reason         String @db.Text
  status         String @default("PENDING")
  createdById    String @db.Uuid
  decidedById    String? @db.Uuid
  decidedAt      DateTime?
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  profile HrmsPayrollProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  @@index([organizationId, employeeId, startPeriod], map: "hrms_variable_pay_inputs_organizationId_employeeId_startPeriod_")
  @@map("hrms_variable_pay_inputs")
}

/// Persisted gross-to-net snapshots are immutable after approval. Sandbox transfers never mark payroll PAID.
model HrmsPayrollRun {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  profileId      String @db.Uuid
  period         String
  /// ALL or a tenant department UUID; employee/period uniqueness is enforced by payroll records at approval.
  scopeKey       String @default("ALL")
  payDate        DateTime @db.Date
  status         String @default("DRAFT")
  snapshot       Json @db.JsonB
  totalNet       Decimal @db.Decimal(18, 4)
  employeeCount  Int
  preparedById   String @db.Uuid
  approvedById   String? @db.Uuid
  approvedAt     DateTime?
  processedAt    DateTime?
  closedById     String? @db.Uuid
  closedAt       DateTime?
  closureReason  String?
  sandboxReference String? @unique
  sandboxStatus  String?
  createdAt      DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  profile HrmsPayrollProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)
  claims HrmsExpenseClaim[]
  records HrmsPayrollRecord[]
  // A partial unique database index permits replacement of CANCELLED/REJECTED drafts without deleting history.
  @@index([organizationId, profileId, period, scopeKey])
  @@index([organizationId, status])
  @@map("hrms_payroll_runs")
}

model HrmsTraining {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  legacyTrainingId String?      @db.Uuid
  title          String
  description    String?        @db.Text
  type           TrainingType
  startDate      DateTime?
  endDate        DateTime?
  status         TrainingStatus @default(SCHEDULED)
  maxParticipants Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  HrmsTrainingEnrollment[]

  @@index([organizationId, status])
  @@unique([organizationId, legacyTrainingId])
  @@map("hrms_trainings")
}

model HrmsTrainingEnrollment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  legacyTrainingEnrollmentId String?      @db.Uuid
  trainingId     String                   @db.Uuid
  employeeId     String                   @db.Uuid
  status         TrainingEnrollmentStatus @default(ENROLLED)
  enrolledAt     DateTime                 @default(now())
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  training     HrmsTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([trainingId, employeeId])
  @@unique([organizationId, legacyTrainingEnrollmentId])
  @@index([organizationId, status])
  @@map("hrms_training_enrollments")
}

model HrmsAsset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  legacyAssetId  String?     @db.Uuid
  name           String
  type           AssetType
  customCategory String?
  serialNumber   String
  condition      AssetCondition @default(GOOD)
  status         AssetStatus @default(AVAILABLE)
  assignedEmployeeId String? @db.Uuid
  assignedAt     DateTime?
  location       String?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedEmployee HrmsEmployee? @relation("HrmsAssetAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, serialNumber])
  @@unique([organizationId, legacyAssetId])
  @@index([organizationId, status])
  @@map("hrms_assets")
}

model HrmsBenefitEnrollment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  legacyHealthInsuranceId String? @db.Uuid
  employeeId     String   @db.Uuid
  provider       String
  planName       String
  policyNumber   String?
  coverageStarts DateTime @db.Date
  coverageEnds   DateTime? @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@unique([organizationId, legacyHealthInsuranceId])
  @@index([employeeId, isActive])
  @@map("hrms_benefit_enrollments")
}

model AttendanceRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  date            DateTime @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus @default(PRESENT)
  workHours       Float?
  breakTime       Int?
  location        String?
  ipAddress       String?
  deviceInfo      String?
  notes           String?  @db.Text
  approvedBy      String?  @db.Uuid
  approvedAt      DateTime?
