model HrmsEmployee {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  employeeNumber String
  status         String
  employmentType String?
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendanceRecords HrmsAttendanceRecord[]
  leaveRequests HrmsLeaveRequest[]
  performanceReviews HrmsPerformanceReview[] @relation("HrmsPerformanceReviewEmployee")
  conductedPerformanceReviews HrmsPerformanceReview[] @relation("HrmsPerformanceReviewReviewer")
  payrollRecords HrmsPayrollRecord[]
  trainingEnrollments HrmsTrainingEnrollment[]
  assignedAssets HrmsAsset[] @relation("HrmsAssetAssignee")
  benefitEnrollments HrmsBenefitEnrollment[]

  @@unique([organizationId, userId])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId, status])
  @@map("hrms_employees")
}

model HrmsAttendanceRecord {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  legacyAttendanceId String?      @db.Uuid
  employeeId     String           @db.Uuid
  date           DateTime         @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  workHours      Float?
  notes          String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@unique([organizationId, legacyAttendanceId])
  @@index([organizationId, date])
  @@index([employeeId, date])
  @@map("hrms_attendance_records")
}

model HrmsLeaveRequest {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  legacyLeaveRequestId String? @db.Uuid
  employeeId     String      @db.Uuid
  leaveType      LeaveType
  startDate      DateTime    @db.Date
  endDate        DateTime    @db.Date
  totalDays      Float
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  approvedByUserId String?   @db.Uuid
  approvedAt     DateTime?
  rejectedByUserId String?   @db.Uuid
  rejectedAt     DateTime?
  rejectionReason String?    @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@unique([organizationId, legacyLeaveRequestId])
  @@index([employeeId, startDate])
  @@map("hrms_leave_requests")
}

model HrmsPerformanceReview {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  legacyPerformanceReviewId String? @db.Uuid
  employeeId     String       @db.Uuid
  reviewerEmployeeId String   @db.Uuid
  reviewType     ReviewType
  cycle          String
  startDate      DateTime     @db.Date
  dueDate        DateTime     @db.Date
  completedAt    DateTime?
  status         ReviewStatus @default(PENDING)
  overallRating  Int?
  comments       String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation("HrmsPerformanceReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer     HrmsEmployee  @relation("HrmsPerformanceReviewReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@unique([organizationId, legacyPerformanceReviewId])
  @@index([employeeId, dueDate])
  @@index([reviewerEmployeeId, dueDate])
  @@map("hrms_performance_reviews")
}

model HrmsPayrollRecord {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  legacyPayrollRecordId String? @db.Uuid
  employeeId     String        @db.Uuid
  period         String
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  payDate        DateTime      @db.Date
  grossSalary    Float
  totalDeductions Float
  netPay         Float
  currency       String        @default("USD")
  status         PayrollStatus @default(DRAFT)
  approvedByUserId String?     @db.Uuid
  approvedAt     DateTime?
  paidAt         DateTime?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, period])
  @@unique([organizationId, legacyPayrollRecordId])
  @@index([organizationId, status])
  @@map("hrms_payroll_records")
}

model HrmsTraining {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  legacyTrainingId String?      @db.Uuid
  title          String
  description    String?        @db.Text
  type           TrainingType
  startDate      DateTime?
  endDate        DateTime?
  status         TrainingStatus @default(SCHEDULED)
  maxParticipants Int?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  HrmsTrainingEnrollment[]

  @@index([organizationId, status])
  @@unique([organizationId, legacyTrainingId])
  @@map("hrms_trainings")
}

model HrmsTrainingEnrollment {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @db.Uuid
  legacyTrainingEnrollmentId String?      @db.Uuid
  trainingId     String                   @db.Uuid
  employeeId     String                   @db.Uuid
  status         TrainingEnrollmentStatus @default(ENROLLED)
  enrolledAt     DateTime                 @default(now())
  completedAt    DateTime?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  training     HrmsTraining @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([trainingId, employeeId])
  @@unique([organizationId, legacyTrainingEnrollmentId])
  @@index([organizationId, status])
  @@map("hrms_training_enrollments")
}

model HrmsAsset {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  legacyAssetId  String?     @db.Uuid
  name           String
  type           AssetType
  serialNumber   String?
  status         AssetStatus @default(AVAILABLE)
  assignedEmployeeId String? @db.Uuid
  assignedAt     DateTime?
  location       String?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedEmployee HrmsEmployee? @relation("HrmsAssetAssignee", fields: [assignedEmployeeId], references: [id], onDelete: SetNull)

  @@unique([organizationId, serialNumber])
  @@unique([organizationId, legacyAssetId])
  @@index([organizationId, status])
  @@map("hrms_assets")
}

model HrmsBenefitEnrollment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  legacyHealthInsuranceId String? @db.Uuid
  employeeId     String   @db.Uuid
  provider       String
  planName       String
  policyNumber   String?
  coverageStarts DateTime @db.Date
  coverageEnds   DateTime? @db.Date
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@unique([organizationId, legacyHealthInsuranceId])
  @@index([employeeId, isActive])
  @@map("hrms_benefit_enrollments")
}

model AttendanceRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  date            DateTime @db.Date
  checkIn         DateTime?
  checkOut        DateTime?
  status          AttendanceStatus @default(PRESENT)
  workHours       Float?
  breakTime       Int?
  location        String?
  ipAddress       String?
  deviceInfo      String?
  notes           String?  @db.Text
  approvedBy      String?  @db.Uuid
  approvedAt      DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([date])
  @@index([status])
  @@map("attendance_records")
}

model LeaveRequest {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  leaveType       LeaveType
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  totalDays       Float
  reason          String?  @db.Text
  status          LeaveStatus @default(PENDING)
  approvedBy      String?  @db.Uuid
  approvedAt      DateTime?
  rejectedBy      String?  @db.Uuid
  rejectedAt      DateTime?
  rejectionReason String?  @db.Text
  attachmentUrls  String[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([status])
  @@index([leaveType])
  @@map("leave_requests")
}

model PerformanceReview {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  reviewerId      String   @db.Uuid
  reviewType      ReviewType
  cycle           String
  startDate       DateTime @db.Date
  dueDate         DateTime @db.Date
  completedAt     DateTime?
  status          ReviewStatus @default(PENDING)
  
  overallRating   Int?
  performanceRating Int?
  behaviorRating  Int?
  leadershipRating Int?
  
  strengths       String?  @db.Text
  areasForImprovement String? @db.Text
  goals           Json?    @db.JsonB
  comments        String?  @db.Text
  employeeComments String? @db.Text
  
  calibrationStatus String?
  finalRating     Int?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewer        UserHRMSProfile     @relation("RevieweeReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([reviewerId])
  @@index([status])
  @@map("performance_reviews")
}

model PayrollRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  period          String
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  payDate         DateTime @db.Date
  
  basicSalary     Float
  allowances      Json?    @db.JsonB
  overtime        Float    @default(0)
  bonus           Float    @default(0)
  commission      Float    @default(0)
  otherEarnings   Float    @default(0)
  grossSalary     Float
  
  tax             Float    @default(0)
  socialSecurity  Float    @default(0)
  healthInsurance Float    @default(0)
  retirement      Float    @default(0)
  otherDeductions Float    @default(0)
  totalDeductions Float
  
  netPay          Float
  currency        String   @default("USD")
  
  status          PayrollStatus @default(DRAFT)
  paidAt          DateTime?
  paymentMethod   String?
  bankAccount     String?
  
  notes           String?
  metadata        Json?    @db.JsonB
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([period])
  @@index([status])
  @@map("payroll_records")
}

model Training {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  description     String?  @db.Text
  type            TrainingType
  provider        String?
  startDate       DateTime?
  endDate         DateTime?
  duration        Int?
  location        String?
  url             String?
  status          TrainingStatus @default(SCHEDULED)
  maxParticipants Int?
  
  enrollments     TrainingEnrollment[]
  
  cost            Float?
  currency        String?  @default("USD")
  
  certificationOffered Boolean @default(false)
  certificationUrl  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([type])
  @@index([status])
  @@map("trainings")
}

model TrainingEnrollment {
  id              String   @id @default(uuid()) @db.Uuid
  trainingId      String   @db.Uuid
  userId          String   @db.Uuid
  enrolledAt      DateTime @default(now())
  completedAt     DateTime?
  status          TrainingEnrollmentStatus @default(ENROLLED)
  score           Float?
  feedback        String?  @db.Text
  certificateUrl  String?
  
  training        Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([trainingId, userId])
  @@index([trainingId])
  @@index([userId])
  @@map("training_enrollments")
}

model Asset {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  type            AssetType
  serialNumber    String?  @unique
  model           String?
  manufacturer    String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  warrantyExpiry  DateTime?
  status          AssetStatus @default(AVAILABLE)
  assignedTo      String?  @db.Uuid
  assignedAt      DateTime?
  assignedBy      String?  @db.Uuid
  condition       String?
  location        String?
  notes           String?  @db.Text
  metadata        Json?    @db.JsonB
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile?    @relation(fields: [assignedTo], references: [id])
  
  @@index([type])
  @@index([status])
  @@index([assignedTo])
  @@map("assets")
}

model HolidayCalendar {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  countryCode    String?
  region         String?
  holidays       Json      @default("[]") @db.JsonB
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("holiday_calendars")
}

model HealthInsurance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  provider       String
  planName       String
  policyNumber   String?
  memberNumber   String?
  coverageStarts DateTime         @db.Date
  coverageEnds   DateTime?        @db.Date
  isActive       Boolean          @default(true)
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         UserHRMSProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([userId, isActive])
  @@map("health_insurances")
}