  @@index([userId])
  @@index([reviewerId])
  @@index([status])
  @@map("performance_reviews")
}

model PayrollRecord {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  period          String
  periodStart     DateTime @db.Date
  periodEnd       DateTime @db.Date
  payDate         DateTime @db.Date
  
  basicSalary     Float
  allowances      Json?    @db.JsonB
  overtime        Float    @default(0)
  bonus           Float    @default(0)
  commission      Float    @default(0)
  otherEarnings   Float    @default(0)
  grossSalary     Float
  
  tax             Float    @default(0)
  socialSecurity  Float    @default(0)
  healthInsurance Float    @default(0)
  retirement      Float    @default(0)
  otherDeductions Float    @default(0)
  totalDeductions Float
  
  netPay          Float
  currency        String   @default("USD")
  
  status          PayrollStatus @default(DRAFT)
  paidAt          DateTime?
  paymentMethod   String?
  bankAccount     String?
  
  notes           String?
  metadata        Json?    @db.JsonB
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([period])
  @@index([status])
  @@map("payroll_records")
}

model Training {
  id              String   @id @default(uuid()) @db.Uuid
  title           String
  description     String?  @db.Text
  type            TrainingType
  provider        String?
  startDate       DateTime?
  endDate         DateTime?
  duration        Int?
  location        String?
  url             String?
  status          TrainingStatus @default(SCHEDULED)
  maxParticipants Int?
  
  enrollments     TrainingEnrollment[]
  
  cost            Float?
  currency        String?  @default("USD")
  
  certificationOffered Boolean @default(false)
  certificationUrl  String?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([type])
  @@index([status])
  @@map("trainings")
}

model TrainingEnrollment {
  id              String   @id @default(uuid()) @db.Uuid
  trainingId      String   @db.Uuid
  userId          String   @db.Uuid
  enrolledAt      DateTime @default(now())
  completedAt     DateTime?
  status          TrainingEnrollmentStatus @default(ENROLLED)
  score           Float?
  feedback        String?  @db.Text
  certificateUrl  String?
  
  training        Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user            UserHRMSProfile     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([trainingId, userId])
  @@index([trainingId])
  @@index([userId])
  @@map("training_enrollments")
}

model Asset {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  type            AssetType
  serialNumber    String?  @unique
  model           String?
  manufacturer    String?
  purchaseDate    DateTime?
  purchasePrice   Float?
  warrantyExpiry  DateTime?
  status          AssetStatus @default(AVAILABLE)
  assignedTo      String?  @db.Uuid
  assignedAt      DateTime?
  assignedBy      String?  @db.Uuid
  condition       String?
  location        String?
  notes           String?  @db.Text
  metadata        Json?    @db.JsonB
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user            UserHRMSProfile?    @relation(fields: [assignedTo], references: [id])
  
  @@index([type])
  @@index([status])
  @@index([assignedTo])
  @@map("assets")
}

model HolidayCalendar {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  countryCode    String?
  region         String?
  holidays       Json      @default("[]") @db.JsonB
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("holiday_calendars")
}

model HealthInsurance {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  provider       String
  planName       String
  policyNumber   String?
  memberNumber   String?
  coverageStarts DateTime         @db.Date
  coverageEnds   DateTime?        @db.Date
  isActive       Boolean          @default(true)
  metadata       Json?            @db.JsonB
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         UserHRMSProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, isActive])
  @@index([userId, isActive])
  @@map("health_insurances")
}
/// One organization-wide holiday on a calendar date. Read by HRMS settings and merged into Pulse's schedule.
model HrmsHoliday {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  // Null applies to every location; otherwise only employees working at that location observe the holiday.
  workLocationId String?  @db.Uuid
  date           DateTime @db.Date
  name           String
  isHalfDay      Boolean  @default(false)
  // Small downscaled data URL (client resizes before upload) used as the calendar cell background.
  imageUrl       String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workLocation HrmsLocation? @relation(fields: [workLocationId], references: [id], onDelete: Cascade)

  // One holiday per (date, location) is enforced in HrmsHolidayService because NULL locations are not unique in SQL.
  @@index([organizationId, date])
  @@index([workLocationId])
  @@map("hrms_holidays")
}

/// Audit trail of holiday-list emails; an ALL broadcast for a year drives the "sent to all" badge.
model HrmsHolidayBroadcast {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  year           Int
  audience       String   @db.VarChar(10)
  recipientCount Int
  failedCount    Int      @default(0)
  // True when only holidays changed since the previous send were emailed.
  changesOnly    Boolean  @default(false)
  holidayCount   Int      @default(0)
  sentByUserId   String?  @db.Uuid
  sentAt         DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, year, sentAt])
  @@map("hrms_holiday_broadcasts")
}

/// Admin-managed leave type with its yearly entitlement; replaces the fixed LeaveType enum for configuration.
model HrmsLeaveType {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  code           String
  // Legacy enum value written to HrmsLeaveRequest.leaveType (consumed by Pulse).
  category       LeaveType @default(VACATION)
  annualDays     Float     @default(0)
  carryForwardDays Float   @default(0)
  isPaid         Boolean   @default(true)
  allowHalfDay   Boolean   @default(true)
  // Balance comes from approved comp-off credits instead of annualDays.
  isCompOff      Boolean   @default(false)
  isActive       Boolean   @default(true)
  sortOrder      Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requests     HrmsLeaveRequest[]

  @@unique([organizationId, code])
  @@map("hrms_leave_types")
}

/// Request to earn leave credit for working on a day off; approval credits `days` to the comp-off balance.
model HrmsCompOffRequest {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  employeeId     String      @db.Uuid
  workedDate     DateTime    @db.Date
  /// Last day worked when the request spans a range; null for a single day.
  workedEndDate  DateTime?   @db.Date
  days           Float       @default(1)
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  requestedByUserId String?  @db.Uuid
  decidedByUserId String?    @db.Uuid
  decidedAt      DateTime?
  decisionReason String?     @db.Text
  moreInfoNote   String?     @db.Text
  moreInfoRequestedByUserId String? @db.Uuid
  moreInfoRequestedAt DateTime?
  moreInfoReply  String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     HrmsEmployee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([employeeId, workedDate])
  @@map("hrms_comp_off_requests")
}
