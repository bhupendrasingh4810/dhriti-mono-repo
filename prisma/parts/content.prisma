model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String
  title       String
  content     String
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, version])
  @@index([type, isPublished])
  @@map("legal_documents")
}

model FaqGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FaqItem[]

  @@map("faq_groups")
}

model FaqItem {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  question  String
  answer    String
  order     Int      @default(0)
  isDraft   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group FaqGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("faq_items")
}

model JobPost {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique
  title          String
  description    String
  department     String?
  location       String?
  employmentType String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished])
  @@map("job_posts")
}
