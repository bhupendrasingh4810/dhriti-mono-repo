  defaultIssueStatus        IssueStatus   @default(BACKLOG)
  defaultIssuePriority      IssuePriority @default(NONE)
  issueListPageSize         Int           @default(100)
  maxIssueEstimate          Int           @default(1000)
  maxIssueDescriptionLength Int           @default(20000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("flow_organization_settings")
}

