model PulseOrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  // ISO weekdays: 1 = Monday ... 7 = Sunday.
  workingDays               Int[]             @default([1, 2, 3, 4])
  workingHoursStart         Int               @default(9)
  workingHoursEnd           Int               @default(18)
  defaultEventAvailability  EventAvailability @default(BUSY)
  defaultEventPrivacy       EventPrivacy      @default(DEFAULT)
  defaultReminderMinutes    Int?
  onlineMeetingsEnabled     Boolean           @default(true)
  maxMeetingAttendees       Int?
  maxEventDurationMinutes   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pulse_organization_settings")
}

model NotesOrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  sharingEnabled        Boolean @default(true)
  defaultShareCanEdit   Boolean @default(false)
  defaultShareCanDelete Boolean @default(false)
  maxSharedUsersPerNote Int?
  maxNoteContentLength  Int     @default(100000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("notes_organization_settings")
}

model HrmsOrganizationSettings {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @unique @db.Uuid

  maxLeaveRequestDays     Int?
  allowHalfDayLeave       Boolean          @default(true)
  defaultAttendanceStatus AttendanceStatus @default(PRESENT)
  defaultPayrollCurrency  String           @default("USD") @db.VarChar(3)
  maxTrainingParticipants Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("hrms_organization_settings")
}
