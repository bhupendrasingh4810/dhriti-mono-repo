// prisma/schema.prisma
// This file is generated by scripts/build-prisma-schema.sh. Do not edit directly.
// Edit the files in prisma/parts/ instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Address {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  label          String   @default("primary")
  recipientName  String?
  line1          String
  line2          String?
  city           String
  state          String?
  postalCode     String?
  countryCode    String
  phoneNumber    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization? @relation("OrganizationAddresses", fields: [organizationId], references: [id], onDelete: Cascade)
  billingOrganization Organization? @relation("OrganizationBillingAddress")
  user               User?         @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([userId])
  @@map("addresses")
}

model BlogCategory {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]

  @@map("blog_categories")
}

model BlogTag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPostTag[]

  @@map("blog_tags")
}

model BlogPost {
  id          String    @id @default(uuid()) @db.Uuid
  slug        String    @unique
  title       String
  excerpt     String?
  content     String
  coverImage  String?
  authorId    String?   @db.Uuid
  categoryId  String?   @db.Uuid
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags     BlogPostTag[]

  @@index([categoryId])
  @@index([isPublished])
  @@map("blog_posts")
}

model BlogPostTag {
  postId String @db.Uuid
  tagId  String @db.Uuid

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tags")
}

model ConnectSidebarPreference {
	id             String   @id @default(uuid()) @db.Uuid
	organizationId String   @db.Uuid
	userId         String   @db.Uuid
	preferences    Json     @db.JsonB
	createdAt      DateTime @default(now())
	updatedAt      DateTime @updatedAt

	organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
	user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

	@@unique([organizationId, userId])
	@@map("connect_sidebar_preferences")
}

model ConnectCall {
	id              String            @id @db.Uuid
	organizationId  String            @db.Uuid
	channelId       String            @db.Uuid
	initiatedById   String            @db.Uuid
	scope           ConnectCallScope
	type            ConnectCallType
	status          ConnectCallStatus @default(RINGING)
	startedAt       DateTime          @default(now())
	endedAt         DateTime?
	durationSeconds Int?

	channel      Channel                  @relation(fields: [channelId], references: [id], onDelete: Cascade)
	participants ConnectCallParticipant[]
	recording    ConnectCallRecording?

	@@index([organizationId, startedAt])
	@@index([channelId, startedAt])
	@@map("connect_calls")
}

model ConnectCallParticipant {
	id        String      @id @default(uuid()) @db.Uuid
	callId    String      @db.Uuid
	userId    String      @db.Uuid
	joinedAt  DateTime?
	leftAt    DateTime?
	createdAt DateTime    @default(now())

	call ConnectCall @relation(fields: [callId], references: [id], onDelete: Cascade)

	@@unique([callId, userId])
	@@index([userId, createdAt])
	@@map("connect_call_participants")
}

model ConnectCallRecording {
	id                  String                 @id @default(uuid()) @db.Uuid
	callId              String                 @unique @db.Uuid
	organizationId      String                 @db.Uuid
	requestedById       String                 @db.Uuid
	participantConsents Json                   @db.JsonB
	status              ConnectRecordingStatus @default(PENDING_CONSENT)
	storageUrl          String?
	startedAt           DateTime?
	endedAt             DateTime?
	durationSeconds     Int?
	createdAt           DateTime               @default(now())
	updatedAt           DateTime               @updatedAt

	call ConnectCall @relation(fields: [callId], references: [id], onDelete: Cascade)

	@@index([organizationId, createdAt])
	@@map("connect_call_recordings")
}


model LegalDocument {
  id          String            @id @default(uuid()) @db.Uuid
  type        LegalDocumentType
  version     String
  title       String
  content     String
  isPublished Boolean           @default(false)
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([type, version])
  @@index([type, isPublished])
  @@map("legal_documents")
}

model FaqGroup {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FaqItem[]

  @@map("faq_groups")
}

model FaqItem {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  question  String
  answer    String
  order     Int      @default(0)
  isDraft   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group FaqGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("faq_items")
}

model JobPost {
  id             String    @id @default(uuid()) @db.Uuid
  slug           String    @unique
  title          String
  description    String
  department     String?
  location       String?
  employmentType String?
  isPublished    Boolean   @default(false)
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isPublished])
  @@map("job_posts")
}


