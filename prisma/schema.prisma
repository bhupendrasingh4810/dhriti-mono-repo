generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model User {
  id                  String      @id @default(uuid()) @db.Uuid
  email               String      @unique
  name                String
  passwordHash        String?
  avatarUrl           String?
  timezone            String      @default("UTC")
  locale              String      @default("en")
  status              UserStatus  @default(PENDING_VERIFICATION)
  platformRole        PlatformRole?
  emailVerifiedAt     DateTime?
  mfaEnabled          Boolean     @default(false)
  mfaSecret           String?
  failedLoginAttempts Int         @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  deletedAt           DateTime?

  identities     UserIdentity[]
  sessions       UserSession[]
  tokens         VerificationToken[]
  recoveryCodes  MfaRecoveryCode[]
  memberships    OrganizationMember[]
  teamMemberships TeamMember[]
  uploadedFiles  StoredFile[]
  createdChannels Channel[]
  atlasPages     AtlasPage[]
  atlasComments  AtlasComment[]
  eventAttendances EventAttendee[]
  nexusTasks     NexusTask[]
  nexusConversations NexusConversation[]
  messages       Message[]
  facilitatedSessions CadenceSession[]
  supportTickets SupportTicket[]
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  sentInvitations Invitation[]
  groupMemberships GroupMember[]

  @@index([status])
  @@map("users")
}

model UserIdentity {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  provider          OAuthProvider
  providerAccountId String
  email             String?
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("user_identities")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  organizationId   String?   @db.Uuid
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  rotatedAt        DateTime?
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model VerificationToken {
  id        String                 @id @default(uuid()) @db.Uuid
  userId    String                 @db.Uuid
  tokenHash String                 @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("mfa_recovery_codes")
}

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  members  OrganizationMember[]
  teams    Team[]
  auditLogs AuditLog[]
  files     StoredFile[]
  channels  Channel[]
  messages  Message[]
  projects  Project[]
  issues    Issue[]
  atlasSpaces   AtlasSpace[]
  atlasPages    AtlasPage[]
  atlasComments AtlasComment[]
  calendars     Calendar[]
  calendarEvents CalendarEvent[]
  nexusTasks    NexusTask[]
  nexusConversations NexusConversation[]
  cadenceSessions CadenceSession[]
  webhooks      Webhook[]
  subscription  Subscription?
  entitlements  ProductEntitlement[]
  featureFlags  FeatureFlag[]
  supportTickets SupportTicket[]
  settings      OrganizationSettings?
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  searchIndex   SearchIndex[]
  searchHistory SearchHistory[]
  invitations   Invitation[]
  groups        Group[]
  usageEvents   UsageEvent[]

  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Team {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  slug           String
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      TeamMember[]
  channels     Channel[]
  cadenceSessions CadenceSession[]
  projects     Project[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String?   @db.Uuid
  actorUserId    String?   @db.Uuid
  action         String
  resourceType   String?
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime  @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

model StoredFile {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  uploadedById   String    @db.Uuid
  bucket         String
  objectKey      String
  originalName   String
  contentType    String
  sizeBytes      Int
  checksumSha256 String
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([uploadedById])
  @@map("stored_files")
}

enum ChannelType {
  CHANNEL
  DIRECT
  GROUP
}

enum ChannelVisibility {
  PUBLIC
  PRIVATE
}

model Channel {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  teamId         String?           @db.Uuid
  name           String
  slug           String?
  type           ChannelType       @default(CHANNEL)
  visibility     ChannelVisibility @default(PUBLIC)
  topic          String?
  description    String?
  isArchived     Boolean           @default(false)
  createdById    String            @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdBy    User           @relation(fields: [createdById], references: [id], onDelete: Restrict)
  members      ChannelMember[]
  messages     Message[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([teamId])
  @@map("channels")
}

model ChannelMember {
  id        String    @id @default(uuid()) @db.Uuid
  channelId String    @db.Uuid
  userId    String    @db.Uuid
  lastReadAt DateTime?
  createdAt DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

model Message {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  channelId        String    @db.Uuid
  authorId         String    @db.Uuid
  parentId         String?   @db.Uuid
  content          String    @db.Text
  contentHtml      String?   @db.Text
  isEdited         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)
  parent       Message?     @relation("ThreadReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("ThreadReplies")
  mentions     MessageMention[]
  reactions    MessageReaction[]

  @@index([channelId, createdAt])
  @@index([parentId])
  @@index([organizationId, channelId])
  @@map("messages")
}

model MessageMention {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_mentions")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @db.Uuid
  userId    String   @db.Uuid
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

// ---------------- Flow ----------------

enum IssueStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum IssuePriority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

model Project {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  teamId         String?   @db.Uuid
  key            String
  name           String
  description    String?
  leadId         String?   @db.Uuid
  isArchived     Boolean   @default(false)
  issueCounter   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  issues       Issue[]
  sprints      Sprint[]
  boards       Board[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("projects")
}

model Board {
  id             String    @id @default(uuid()) @db.Uuid
  projectId      String    @db.Uuid
  name           String
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  project Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  columns BoardColumn[]

  @@index([projectId])
  @@map("boards")
}

model BoardColumn {
  id        String   @id @default(uuid()) @db.Uuid
  boardId   String   @db.Uuid
  name      String
  status    IssueStatus
  position  Int
  wipLimit  Int?
  createdAt DateTime @default(now())

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId, position])
  @@map("board_columns")
}

model Sprint {
  id          String    @id @default(uuid()) @db.Uuid
  projectId   String    @db.Uuid
  name        String
  goal        String?
  startDate   DateTime?
  endDate     DateTime?
  isActive    Boolean   @default(false)
  isCompleted Boolean   @default(false)
  createdAt   DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId])
  @@map("sprints")
}

model Issue {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  projectId      String        @db.Uuid
  sprintId       String?       @db.Uuid
  number         Int
  title          String
  description    String?       @db.Text
  status         IssueStatus   @default(BACKLOG)
  priority       IssuePriority @default(NONE)
  assigneeId     String?       @db.Uuid
  reporterId     String        @db.Uuid
  estimate       Int?
  position       Int           @default(0)
  dueDate        DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint       Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([organizationId, projectId])
  @@index([status])
  @@index([assigneeId])
  @@index([sprintId])
  @@map("issues")
}

// ---------------- Atlas ----------------

model AtlasSpace {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  key            String
  name           String
  description    String?
  icon           String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pages        AtlasPage[]

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("atlas_spaces")
}

model AtlasPage {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  spaceId        String    @db.Uuid
  parentId       String?   @db.Uuid
  title          String
  content        String    @default("") @db.Text
  position       Int       @default(0)
  isPublished    Boolean   @default(false)
  version        Int       @default(1)
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  space        AtlasSpace   @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [createdById], references: [id], onDelete: Restrict)
  parent       AtlasPage?   @relation("PageTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     AtlasPage[]  @relation("PageTree")
  comments     AtlasComment[]

  @@index([spaceId, position])
  @@index([parentId])
  @@index([organizationId, spaceId])
  @@map("atlas_pages")
}

model AtlasComment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  pageId         String    @db.Uuid
  authorId       String    @db.Uuid
  content        String    @db.Text
  isResolved     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  page         AtlasPage    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([pageId, createdAt])
  @@map("atlas_comments")
}

// ---------------- Pulse ----------------

enum RsvpStatus {
  PENDING
  ACCEPTED
  DECLINED
  TENTATIVE
}

model Calendar {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  ownerId        String    @db.Uuid
  name           String
  color          String?
  isDefault      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events       CalendarEvent[]

  @@index([organizationId])
  @@map("calendars")
}

model CalendarEvent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  calendarId     String    @db.Uuid
  title          String
  description    String?   @db.Text
  location       String?
  meetingUrl     String?
  startsAt       DateTime
  endsAt         DateTime
  isAllDay       Boolean   @default(false)
  recurrenceRule String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  calendar     Calendar     @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  attendees    EventAttendee[]

  @@index([calendarId, startsAt])
  @@index([organizationId, startsAt])
  @@map("calendar_events")
}

model EventAttendee {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @db.Uuid
  userId    String     @db.Uuid
  status    RsvpStatus @default(PENDING)
  isOrganizer Boolean  @default(false)
  createdAt DateTime   @default(now())

  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_attendees")
}

// ---------------- Nexus AI ----------------

enum NexusTaskStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum NexusTaskType {
  SUMMARIZE_CONVERSATION
  SUMMARIZE_PAGE
  EXTRACT_TASKS
  MEETING_NOTES
  ASK
}

model NexusTask {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  requestedById  String          @db.Uuid
  type           NexusTaskType
  status         NexusTaskStatus @default(PENDING)
  input          Json
  result         Json?
  error          String?
  // Optional link to the source being processed.
  sourceType     String?
  sourceId       String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedBy  User         @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([requestedById, createdAt])
  @@index([status])
  @@map("nexus_tasks")
}

model NexusConversation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  userId         String    @db.Uuid
  title          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     NexusMessage[]

  @@index([userId, updatedAt])
  @@map("nexus_conversations")
}

model NexusMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           String
  content        String   @db.Text
  tokens         Int?
  createdAt      DateTime @default(now())

  conversation NexusConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("nexus_messages")
}

// ---------------- Cadence ----------------

enum CadencePhase {
  COLLECT
  GROUP
  VOTE
  DISCUSS
  DONE
}

enum CadenceSessionType {
  RETROSPECTIVE
  ESTIMATION
  CHECKIN
}

model CadenceSession {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  teamId         String?            @db.Uuid
  type           CadenceSessionType
  title          String
  phase          CadencePhase       @default(COLLECT)
  facilitatorId  String             @db.Uuid
  isAnonymous    Boolean            @default(true)
  createdAt      DateTime           @default(now())
  startedAt      DateTime?
  endedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  facilitator  User         @relation(fields: [facilitatorId], references: [id], onDelete: Restrict)
  cards        CadenceCard[]

  @@index([organizationId, createdAt])
  @@index([teamId])
  @@map("cadence_sessions")
}

model CadenceCard {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @db.Uuid
  authorId    String    @db.Uuid
  content     String    @db.Text
  column      String    // "went-well" | "to-improve" | "action-items" | custom
  groupId     String?   @db.Uuid
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  session CadenceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  votes   CadenceVote[]

  @@index([sessionId, column])
  @@index([groupId])
  @@map("cadence_cards")
}

model CadenceVote {
  id        String   @id @default(uuid()) @db.Uuid
  cardId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  card CadenceCard @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([cardId, userId])
  @@index([userId])
  @@map("cadence_votes")
}

// ---------------- Webhooks ----------------

model Webhook {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  url            String
  secret         String
  events         String[]  // e.g. ["issue.created", "message.created"]
  isActive       Boolean   @default(true)
  description    String?
  createdById    String    @db.Uuid
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhooks")
}

model WebhookDelivery {
  id          String    @id @default(uuid()) @db.Uuid
  webhookId   String    @db.Uuid
  event       String
  payload     Json
  statusCode  Int?
  success     Boolean   @default(false)
  attempt     Int       @default(1)
  durationMs  Int?
  error       String?
  createdAt   DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ---------------- Control ----------------

enum PlatformRole {
  SUPER_ADMIN
  SUPPORT
  BILLING
  SECURITY
  ENGINEERING
}

enum SubscriptionPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  ESCALATED
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  priceMonthly Int     @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entitlements ProductEntitlement[]

  @@map("products")
}

model Subscription {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @unique @db.Uuid
  plan           SubscriptionPlan   @default(FREE)
  status         SubscriptionStatus @default(TRIALING)
  seats          Int                @default(5)
  currentPeriodEnd DateTime?
  cancelAtPeriodEnd Boolean         @default(false)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model ProductEntitlement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  productId      String   @db.Uuid
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productId])
  @@map("product_entitlements")
}

model FeatureFlag {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  key            String
  isEnabled      Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("feature_flags")
}

model SupportTicket {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String?              @db.Uuid
  userId         String               @db.Uuid
  subject        String
  body           String               @db.Text
  status         SupportTicketStatus  @default(OPEN)
  priority       SupportTicketPriority @default(NORMAL)
  assignedToId   String?
  notes          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, priority])
  @@index([organizationId])
  @@map("support_tickets")
}

model OrganizationSettings {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @unique @db.Uuid
  domain         String?
  brandingLogoUrl String?
  timezone       String   @default("UTC")
  locale         String   @default("en")
  mfaEnforced    Boolean  @default(false)
  passwordMinLength Int   @default(10)
  sessionTimeoutMinutes Int @default(10080)
  dataRetentionDays Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_settings")
}

// ---------------- Notifications ----------------

enum NotificationType {
  MENTION
  ASSIGNMENT
  DUE_DATE
  MEETING_REMINDER
  COMMENT
  SYSTEM
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  type           NotificationType
  title          String
  body           String?
  linkUrl        String?
  metadata       Json?
  isRead         Boolean          @default(false)
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  type           NotificationType
  inApp          Boolean  @default(true)
  email          Boolean  @default(true)
  push           Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, type])
  @@map("notification_preferences")
}

// ---------------- Search ----------------

model SearchIndex {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  entityType     String   // "message" | "issue" | "page" | "event" | "user"
  entityId       String
  title          String
  content        String   @db.Text
  // Full-text search vector (PostgreSQL tsvector) maintained by a trigger.
  authorId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, entityType, entityId])
  @@index([organizationId, entityType])
  @@map("search_index")
}

model SearchHistory {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  query          String
  resultsCount   Int      @default(0)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("search_history")
}

// ---------------- IAM: invitations & groups ----------------

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  role           OrganizationRole @default(MEMBER)
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String           @db.Uuid
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User         @relation(fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([email])
  @@map("invitations")
}

model Group {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  description    String?
  // Dynamic rule (JSON) for rule-based membership; null = manual group.
  rule           Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members      GroupMember[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("groups")
}

model GroupMember {
  id        String   @id @default(uuid()) @db.Uuid
  groupId   String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@map("group_members")
}

// ---------------- Analytics ----------------

model UsageEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String?  @db.Uuid
  // e.g. "message.sent", "issue.created", "page.edited", "api.call"
  event          String
  // App the event belongs to: connect | flow | atlas | pulse | nexus | cadence | platform
  app            String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, app, createdAt])
  @@map("usage_events")
}
